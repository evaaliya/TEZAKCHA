SOLANA_RPC_URL=https://api.devnet.solana.com
# Only "devnet" is supported. Mainnet is refused at startup.
SOLANA_CLUSTER=devnet
# base58 secret key OR JSON byte array — fee sponsor (pays network fees). Server only.
FEE_PAYER_SECRET_KEY=
# Circle USDC on Solana devnet (decimals read from mint via RPC)
USDC_DEVNET_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Minimum SOL balance the fee payer must hold (sponsorship=on)
FEE_PAYER_MIN_SOL=0.05
# on = app pays network fees; off = sender pays (sender must hold SOL)
FEE_SPONSORSHIP=on
# Fallback recipient pubkey when phone is not in config/recipients.json
DEMO_RECIPIENT_PUBKEY=
# How long a prepared (unsigned) tx remains valid
PREPARE_TTL_SECONDS=120
# Max send amount in sender currency (RUB)
AMOUNT_SEND_MAX=1000000
RATES_SOURCE=live
RATES_TTL_SECONDS=3600
RATES_FETCH_TIMEOUT_MS=3000
# E2E only (scripts/devnet-e2e.ts) — user wallet stand-in; never used by the app server
E2E_SENDER_SECRET_KEY=
